{
  "addons": [
    {
      "id": "lsp",
      "name": "Language Server Protocol",
      "description": "LSP client (lite-xl-lsp d1432ae) with our changes: squiggly diagnostics, diagnostics in hover popups, mouse_hover_mode.",
      "version": "0.10",
      "mod_version": "3",
      "path": "addons/plugins/lsp",
      "dependencies": { "widget": {}, "lintplus": {} }
    },
    {
      "id": "lintplus",
      "name": "Lint+",
      "description": "Linting plugin (lintplus 1aa6d2d) with squiggly underlines.",
      "version": "0.7",
      "mod_version": "3",
      "path": "addons/plugins/lintplus",
      "dependencies": { "shapes": {} }
    },
    {
      "id": "build",
      "description": "Build plugin (lite-xl-ide 50c1b40) with a task backend; toolbar font scales with SCALE.",
      "version": "0.2",
      "mod_version": "3",
      "path": "addons/plugins/build",
      "dependencies": { "json": {} }
    },
    {
      "id": "debugger",
      "description": "Debugger (lite-xl-ide 50c1b40) with a breakpoint column and glyph markers.",
      "version": "0.2",
      "mod_version": "3",
      "path": "addons/plugins/debugger",
      "dependencies": { "build": {}, "json": {} }
    },
    {
      "id": "repl",
      "description": "Evaluate Lua in a running lite-xl; used by scripts/lxeval.",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/plugins/repl.lua"
    },
    {
      "id": "language_yaml",
      "description": "Syntax for YAML, with block scalars, YAML 1.2 booleans and null, one-character keys.",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/plugins/language_yaml.lua"
    },
    {
      "id": "tab_switcher",
      "description": "Switch tabs from a list; show_list option to switch without it.",
      "version": "0.3",
      "mod_version": "3",
      "path": "addons/plugins/tab_switcher.lua"
    },
    {
      "id": "minimap",
      "description": "Minimap, following our scrollbar's paging on track clicks.",
      "version": "0.4",
      "mod_version": "3",
      "path": "addons/plugins/minimap.lua"
    },
    {
      "id": "tab_overflow",
      "description": "Tab bar buttons for when tabs scroll: scroll left/right, and a menu of all tabs.",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/plugins/tab_overflow.lua"
    },
    {
      "id": "menubar",
      "description": "A menu bar of commands, shown when Alt is tapped.",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/plugins/menubar.lua"
    },
    {
      "id": "highlight_selection",
      "description": "Marks the other occurrences of the selected text (whole words when a word is selected).",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/plugins/highlight_selection.lua"
    },
    {
      "id": "search_ui",
      "description": "Search and replace interface using Widgets (lite-xl-plugins 6e4aa64).",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/plugins/search_ui.lua",
      "dependencies": { "widget": {} }
    },
    {
      "id": "ephemeral_tabs",
      "description": "Preview tabs (lite-xl-plugins 6e4aa64).",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/plugins/ephemeral_tabs.lua"
    },
    {
      "id": "nerdicons",
      "description": "File icons for TreeView and tabs from Nerd Font symbols (lite-xl-plugins 6e4aa64); tab icons no longer cover truncated titles; icon colors adjusted for contrast.",
      "version": "1.2.4",
      "mod_version": "3",
      "path": "addons/plugins/nerdicons.lua",
      "dependencies": { "font_symbols_nerdfont_mono_regular": {} }
    },
    {
      "id": "terminal",
      "description": "Integrated terminal (lite-xl-terminal e1cd371); libterminal is built by lite-xl's meson build.",
      "version": "1.10",
      "mod_version": "3",
      "path": "addons/plugins/terminal"
    },
    {
      "id": "widget",
      "type": "library",
      "description": "Widget toolkit (lite-xl-widgets) that doesn't queue redraws when showing a visible widget.",
      "version": "0.2.1",
      "mod_version": "3",
      "path": "addons/libraries/widget"
    },
    {
      "id": "shapes",
      "type": "library",
      "description": "Antialiased shape helpers (squiggle) using renderer.draw_path.",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/libraries/shapes.lua"
    },
    {
      "id": "qtcreator",
      "type": "color",
      "description": "Light theme matching Qt Creator's.",
      "version": "0.1",
      "mod_version": "3",
      "path": "addons/colors/qtcreator.lua"
    }
  ]
}
