#!/bin/bash
# Run lpm (lite-xl's plugin manager) for the editor scripts/run.sh builds and runs.
#
# This repo is an lpm repository (manifest.json, add-ons in addons/).  The first time
# lpm runs for a user dir, this adds the checkout as its first repository, so our
# add-ons win over upstream ones of the same id.  Install ours with --symlink, so the
# user dir links back to addons/ and edits take effect on restart; install upstream
# ones without it (a copy, which `lpm repo update` won't change underneath you):
#
#   scripts/lpm install --symlink lsp repl
#   scripts/lpm install --no-install-optional bracketmatch search_ui
#
# lpm is our fork (lpm/ here).  Its settings (repositories, installed add-ons) are per
# user dir, in <userdir>/lpm; the repo cache is shared.
#
# Environment:
#   LITE_BUILD    meson build dir (default: build/), as for run.sh
#   LITE_USERDIR  user config dir (default: user/ next to this repo), as for run.sh
#   LPM           lpm binary (default: our fork's, lpm/ here, built by meson as
#                 <build>/lpm/lpm; it loads lpm/src/lpm.lua at start)
set -e

src=$(dirname "$(dirname "$(readlink -f "$0")")")
top=$(dirname "$src")
build=${LITE_BUILD:-$src/build}
userdir=${LITE_USERDIR:-$top/user}
lpm=${LPM:-$build/lpm/lpm}

args=(--userdir="$userdir" --configdir="$userdir/lpm"
      --cachedir="$top/tools/lpm-cache"
      --datadir="$build/run/share/lite-xl" --binary="$build/run/bin/lite-xl")

if [ ! -x "$lpm" ]; then
  echo "lpm: $lpm not built (meson skips it without its dependencies; see -Dlpm)" >&2
  exit 1
fi
if [ ! -e "$userdir/lpm/settings.json" ]; then
  "$lpm" repo add "$src" "${args[@]}" >&2
fi
exec "$lpm" "$@" "${args[@]}"
