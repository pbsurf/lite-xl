#!/bin/bash
# Save what a running lite-xl draws as a PNG, e.g. an offscreen test instance.
#
# Usage: scripts/screenshot PID OUT.png [X Y W H [ZOOM]]
#
# The window surface is saved as BMP through gdb (SDL_VIDEO_OFFSCREEN_SAVE_FRAMES
# saves nothing with our build), then converted with Python's zlib (no image tools
# are installed). X Y W H crop it, in surface pixels; ZOOM scales it up with nearest
# neighbor, to inspect antialiasing.
set -e
[ $# -ge 2 ] || { sed -n '4p' "$0" | sed 's/^# //'; exit 1; }
pid=$1 out=$2; shift 2
# A lite-xl on Windows (seen from WSL): it saves the PNG itself, asked through the repl
# plugin with renderer.save_screenshot(); no debugger or Python needed.
if [ ! -d "/proc/$pid" ] && command -v cmd.exe >/dev/null; then
  tmp=$(wslpath "$(cmd.exe /c 'echo %TEMP%' 2>/dev/null | tr -d '\r')")/lxshot-$$.png
  args=; [ $# -ge 4 ] && args=", $1, $2, $3, $4${5:+, $5}"
  reply=$("$(dirname "$0")/lxeval" -p "$pid" "renderer.save_screenshot([[$(wslpath -w "$tmp")]]$args)")
  case $reply in
    true) mv -f "$tmp" "$out" ;;
    *) echo "screenshot: $reply" >&2; exit 1 ;;
  esac
  exit 0
fi

bmp=$(mktemp --suffix=.bmp)
trap 'rm -f "$bmp"' EXIT
gdb -p "$pid" -batch \
  -ex "call (int)SDL_SaveBMP((void*)SDL_GetWindowSurface(window_renderer.window), \"$bmp\")" \
  >/dev/null 2>&1 || true
[ -s "$bmp" ] || { echo "screenshot: saving the window surface failed" >&2; exit 1; }
python3 -I - "$bmp" "$out" "$@" <<'EOF'
import sys, struct, zlib
d = open(sys.argv[1], 'rb').read()
off, = struct.unpack_from('<I', d, 10)
w, h, _, bpp = struct.unpack_from('<iiHH', d, 18)
flip = h > 0; h = abs(h); bp = bpp // 8; stride = (w * bp + 3) & ~3
x0, y0, cw, ch, z = 0, 0, w, h, 1
if len(sys.argv) >= 7: x0, y0, cw, ch = map(int, sys.argv[3:7])
if len(sys.argv) >= 8: z = int(sys.argv[7])
cw, ch = min(cw, w - x0), min(ch, h - y0)
rows = []
for y in range(ch * z):
    r = y0 + y // z
    i0 = off + ((h - 1 - r) if flip else r) * stride
    row = bytearray([0])
    for x in range(cw * z):
        i = i0 + (x0 + x // z) * bp
        row += bytes((d[i+2], d[i+1], d[i]))
    rows.append(bytes(row))
def chunk(t, b): return struct.pack('>I', len(b)) + t + b + struct.pack('>I', zlib.crc32(t + b))
open(sys.argv[2], 'wb').write(b'\x89PNG\r\n\x1a\n'
    + chunk(b'IHDR', struct.pack('>IIBBBBB', cw * z, ch * z, 8, 2, 0, 0, 0))
    + chunk(b'IDAT', zlib.compress(b''.join(rows))) + chunk(b'IEND', b''))
EOF
